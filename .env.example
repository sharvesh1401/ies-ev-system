# PROJECT SETTINGS
PROJECT_NAME=IES_EV_System
VERSION=0.1.0
ENV=development

# BACKEND SETTINGS
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info
SECRET_KEY=change_this_in_production_secret_key_12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# DATABASE SETTINGS (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ies_ev_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# REDIS SETTINGS
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# AI SERVICE SETTINGS (DeepSeek)
# Get your API key from: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-coder

# EXTERNAL API KEYS (all proxied through the backend — never exposed to the browser)
# OpenRouteService — route geometry, driving directions
# Get your free key at: https://openrouteservice.org/dev/#/signup
ORS_API_KEY=your_ors_api_key_here

# OpenWeatherMap — weather conditions along the route
# Get your free key at: https://home.openweathermap.org/users/sign_up
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Open Charge Map — EV charging stations
# Get your free key at: https://openchargemap.org/site/developerinfo
OPENCHARGE_API_KEY=your_opencharge_api_key_here

# Open-Elevation — elevation profiles (free, no key needed)
# Served via https://api.open-elevation.com — no API key required

# FRONTEND SETTINGS
# These are used by Docker Compose to configure the frontend service
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8000
